# Copy this file to .env.local and fill in the keys you have, then restart `npm run dev`.
# Both are optional: without them the app uses Ryanair only.

# easyJet, Jet2 & other airlines (recent cached prices). Free.
# Sign up at https://www.travelpayouts.com, then find your API token in the dashboard
# (Profile / API token).
TRAVELPAYOUTS_TOKEN=

# Live Google Flights check in "Pick a destination" mode (all airlines). 250 free searches/month.
# Sign up at https://serpapi.com, then copy your key from https://serpapi.com/manage-api-key
SERPAPI_KEY=
